# This is a TEMPLATE. Real values are org-specific and must never be committed.
#
# Recommended: copy this to a path OUTSIDE the repo (so it can't be staged at all),
# then point the loader at it once:
#     PowerShell:  setx MCC_ENV_FILE "C:\Users\you\secrets\gpulab.env"
#     bash:        export MCC_ENV_FILE="$HOME/.secrets/gpulab.env"
# Open a new shell after `setx` so it takes effect.
#
# Alternative: copy this to `.env` in the repo root (gitignored) — convenient for a
# quick start, but the external path above keeps secrets off the repo tree entirely.
# You can also skip the file and just export the variables directly.

# S3 location of the raw melt signal blobs.
MCC_S3_BUCKET=your-bucket-name-here

# The "eva_db" segment of the object key: {chip_id}/{MCC_S3_EVA_DB}/{chip_id}.bson.gz
# Set this to whatever your org uses for the signal-melt database name.
MCC_S3_EVA_DB=signal_melt_db

# Optional: AWS region / profile. If unset, boto3 uses its normal resolution
# chain (env vars, ~/.aws/credentials, ~/.aws/config, instance role, etc.).
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Where to cache downloaded raw curves and built datasets (kept out of git).
MCC_DATA_DIR=data
